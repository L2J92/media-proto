# 데이터베이스 (비우면 로컬 H2 파일 DB 사용)
# 로컬: jdbc:postgresql://localhost:5432/live
# Neon: jdbc:postgresql://ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DB_URL=jdbc:postgresql://localhost:5432/live
DB_USERNAME=live
DB_PASSWORD=change-me

# LiveKit Cloud (https://cloud.livekit.io → Settings → Keys)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxx
LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxx

# 배포 환경(HTTPS)에서는 true
COOKIE_SECURE=false
# 송출자 연결이 끊긴 뒤 자동 종료까지 유예 시간
PUBLISHER_GRACE_PERIOD=45s
# 평가용 데모 로그인 버튼
DEMO_ACCOUNTS_ENABLED=true

# 토스페이먼츠 테스트 키 (개발자센터 → API 키 → 결제창 연동 키 test_ck_/test_sk_)
TOSS_CLIENT_KEY=test_ck_xxxxxxxx
TOSS_SECRET_KEY=test_sk_xxxxxxxx

# 녹화 (S3 호환 저장소, 예: Cloudflare R2)
RECORDING_ENABLED=false
S3_ACCESS_KEY=
S3_SECRET=
S3_REGION=auto
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET=live-recordings
S3_PUBLIC_BASE_URL=https://pub-xxxx.r2.dev
